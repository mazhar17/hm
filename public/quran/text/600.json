[{"key":"100:10","text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"key":"100:11","text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"},{"key":"101:1","text":" ٱلْقَارِعَةُ"},{"key":"101:2","text":"مَا ٱلْقَارِعَةُ"},{"key":"101:3","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"},{"key":"101:4","text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"},{"key":"101:5","text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"},{"key":"101:6","text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"key":"101:7","text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"},{"key":"101:8","text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"key":"101:9","text":"فَأُمُّهُۥ هَاوِيَةٌ"},{"key":"101:10","text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"},{"key":"101:11","text":"نَارٌ حَامِيَةٌۢ"},{"key":"102:1","text":" أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"key":"102:2","text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"key":"102:3","text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"key":"102:4","text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"key":"102:5","text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"key":"102:6","text":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"key":"102:7","text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"key":"102:8","text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]