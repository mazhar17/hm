[{"key":"86:1","text":" وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"key":"86:2","text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"key":"86:3","text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"key":"86:4","text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"key":"86:5","text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"key":"86:6","text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"key":"86:7","text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"key":"86:8","text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"key":"86:9","text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"key":"86:10","text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"key":"86:11","text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"key":"86:12","text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"key":"86:13","text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"key":"86:14","text":"وَمَا هُوَ بِٱلْهَزْلِ"},{"key":"86:15","text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"key":"86:16","text":"وَأَكِيدُ كَيْدًا"},{"key":"86:17","text":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"},{"key":"87:1","text":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"key":"87:2","text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"key":"87:3","text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"key":"87:4","text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"key":"87:5","text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"key":"87:6","text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"key":"87:7","text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"key":"87:8","text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"key":"87:9","text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"key":"87:10","text":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"key":"87:11","text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"key":"87:12","text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"key":"87:13","text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"key":"87:14","text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"key":"87:15","text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"}]