[{"key":"109:1","text":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"},{"key":"109:2","text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"key":"109:3","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"key":"109:4","text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"key":"109:5","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"key":"109:6","text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"},{"key":"110:1","text":" إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ"},{"key":"110:2","text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا"},{"key":"110:3","text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا"},{"key":"111:1","text":" تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ"},{"key":"111:2","text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ"},{"key":"111:3","text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ"},{"key":"111:4","text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ"},{"key":"111:5","text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ"}]