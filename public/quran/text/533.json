[{"key":"55:41","text":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"},{"key":"55:42","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:43","text":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"},{"key":"55:44","text":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"},{"key":"55:45","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:46","text":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"},{"key":"55:47","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:48","text":"ذَوَاتَآ أَفْنَانٍ"},{"key":"55:49","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:50","text":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ"},{"key":"55:51","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:52","text":"فِيهِمَا مِن كُلِّ فَـٰكِهَةٍ زَوْجَانِ"},{"key":"55:53","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:54","text":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"},{"key":"55:55","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:56","text":"فِيهِنَّ قَـٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"},{"key":"55:57","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:58","text":"كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"},{"key":"55:59","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:60","text":"هَلْ جَزَآءُ ٱلْإِحْسَـٰنِ إِلَّا ٱلْإِحْسَـٰنُ"},{"key":"55:61","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:62","text":"وَمِن دُونِهِمَا جَنَّتَانِ"},{"key":"55:63","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:64","text":"مُدْهَآمَّتَانِ"},{"key":"55:65","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:66","text":"فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"},{"key":"55:67","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}]