[{"key":"37:25","text":"مَا لَكُمْ لَا تَنَاصَرُونَ"},{"key":"37:26","text":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"},{"key":"37:27","text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"key":"37:28","text":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"},{"key":"37:29","text":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"},{"key":"37:30","text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ"},{"key":"37:31","text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ"},{"key":"37:32","text":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ"},{"key":"37:33","text":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"},{"key":"37:34","text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"key":"37:35","text":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"},{"key":"37:36","text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"},{"key":"37:37","text":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"},{"key":"37:38","text":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"},{"key":"37:39","text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"},{"key":"37:40","text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"key":"37:41","text":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"},{"key":"37:42","text":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ"},{"key":"37:43","text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},{"key":"37:44","text":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ"},{"key":"37:45","text":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"},{"key":"37:46","text":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ"},{"key":"37:47","text":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"},{"key":"37:48","text":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"},{"key":"37:49","text":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"},{"key":"37:50","text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"},{"key":"37:51","text":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"}]