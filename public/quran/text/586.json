[{"key":"81:1","text":" إِذَا ٱلشَّمْسُ كُوِّرَتْ"},{"key":"81:2","text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"},{"key":"81:3","text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"},{"key":"81:4","text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"},{"key":"81:5","text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"},{"key":"81:6","text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"},{"key":"81:7","text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"},{"key":"81:8","text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"},{"key":"81:9","text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ"},{"key":"81:10","text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ"},{"key":"81:11","text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"},{"key":"81:12","text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"},{"key":"81:13","text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"},{"key":"81:14","text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"},{"key":"81:15","text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"},{"key":"81:16","text":"ٱلْجَوَارِ ٱلْكُنَّسِ"},{"key":"81:17","text":"وَٱلَّيْلِ إِذَا عَسْعَسَ"},{"key":"81:18","text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ"},{"key":"81:19","text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"key":"81:20","text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"},{"key":"81:21","text":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"key":"81:22","text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"key":"81:23","text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"},{"key":"81:24","text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"},{"key":"81:25","text":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"},{"key":"81:26","text":"فَأَيْنَ تَذْهَبُونَ"},{"key":"81:27","text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"},{"key":"81:28","text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"key":"81:29","text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}]