[{"key":"89:24","text":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"key":"89:25","text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"key":"89:26","text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"key":"89:27","text":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"key":"89:28","text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"key":"89:29","text":"فَٱدْخُلِى فِى عِبَـٰدِى"},{"key":"89:30","text":"وَٱدْخُلِى جَنَّتِى"},{"key":"90:1","text":" لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ"},{"key":"90:2","text":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ"},{"key":"90:3","text":"وَوَالِدٍ وَمَا وَلَدَ"},{"key":"90:4","text":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ"},{"key":"90:5","text":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"},{"key":"90:6","text":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"},{"key":"90:7","text":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"},{"key":"90:8","text":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"key":"90:9","text":"وَلِسَانًا وَشَفَتَيْنِ"},{"key":"90:10","text":"وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ"},{"key":"90:11","text":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"},{"key":"90:12","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"},{"key":"90:13","text":"فَكُّ رَقَبَةٍ"},{"key":"90:14","text":"أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"},{"key":"90:15","text":"يَتِيمًا ذَا مَقْرَبَةٍ"},{"key":"90:16","text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"},{"key":"90:17","text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"},{"key":"90:18","text":"أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"key":"90:19","text":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"key":"90:20","text":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"}]