[{"key":"103:1","text":" وَٱلْعَصْرِ"},{"key":"103:2","text":"إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ"},{"key":"103:3","text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"},{"key":"104:1","text":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"key":"104:2","text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"key":"104:3","text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"key":"104:4","text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"key":"104:5","text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"key":"104:6","text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"key":"104:7","text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"key":"104:8","text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"key":"104:9","text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"},{"key":"105:1","text":" أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"},{"key":"105:2","text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"key":"105:3","text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"key":"105:4","text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"key":"105:5","text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]