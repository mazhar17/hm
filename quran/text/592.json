[{"key":"87:16","text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"key":"87:17","text":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"key":"87:18","text":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"key":"87:19","text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"},{"key":"88:1","text":" هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ"},{"key":"88:2","text":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ"},{"key":"88:3","text":"عَامِلَةٌ نَّاصِبَةٌ"},{"key":"88:4","text":"تَصْلَىٰ نَارًا حَامِيَةً"},{"key":"88:5","text":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"key":"88:6","text":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"},{"key":"88:7","text":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"},{"key":"88:8","text":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"},{"key":"88:9","text":"لِّسَعْيِهَا رَاضِيَةٌ"},{"key":"88:10","text":"فِى جَنَّةٍ عَالِيَةٍ"},{"key":"88:11","text":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً"},{"key":"88:12","text":"فِيهَا عَيْنٌ جَارِيَةٌ"},{"key":"88:13","text":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ"},{"key":"88:14","text":"وَأَكْوَابٌ مَّوْضُوعَةٌ"},{"key":"88:15","text":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"key":"88:16","text":"وَزَرَابِىُّ مَبْثُوثَةٌ"},{"key":"88:17","text":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"},{"key":"88:18","text":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"},{"key":"88:19","text":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"},{"key":"88:20","text":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"},{"key":"88:21","text":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"},{"key":"88:22","text":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"},{"key":"88:23","text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"},{"key":"88:24","text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"},{"key":"88:25","text":"إِنَّ إِلَيْنَآ إِيَابَهُمْ"},{"key":"88:26","text":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"}]