[{"key":"56:77","text":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"},{"key":"56:78","text":"فِى كِتَـٰبٍ مَّكْنُونٍ"},{"key":"56:79","text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"},{"key":"56:80","text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"key":"56:81","text":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"key":"56:82","text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"key":"56:83","text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"},{"key":"56:84","text":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"},{"key":"56:85","text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"},{"key":"56:86","text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"key":"56:87","text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"},{"key":"56:88","text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"},{"key":"56:89","text":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"key":"56:90","text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"key":"56:91","text":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"key":"56:92","text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"key":"56:93","text":"فَنُزُلٌ مِّنْ حَمِيمٍ"},{"key":"56:94","text":"وَتَصْلِيَةُ جَحِيمٍ"},{"key":"56:95","text":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"},{"key":"56:96","text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"key":"57:1","text":" سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ"},{"key":"57:2","text":"لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ يُحْىِۦ وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ"},{"key":"57:3","text":"هُوَ ٱلْأَوَّلُ وَٱلْـَٔاخِرُ وَٱلظَّـٰهِرُ وَٱلْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ"}]