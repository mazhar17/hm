[{"key":"74:48","text":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ"},{"key":"74:49","text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ"},{"key":"74:50","text":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ"},{"key":"74:51","text":"فَرَّتْ مِن قَسْوَرَةٍۭ"},{"key":"74:52","text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً"},{"key":"74:53","text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ"},{"key":"74:54","text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ"},{"key":"74:55","text":"فَمَن شَآءَ ذَكَرَهُۥ"},{"key":"74:56","text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ"},{"key":"75:1","text":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ"},{"key":"75:2","text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"},{"key":"75:3","text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"key":"75:4","text":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"},{"key":"75:5","text":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ"},{"key":"75:6","text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ"},{"key":"75:7","text":"فَإِذَا بَرِقَ ٱلْبَصَرُ"},{"key":"75:8","text":"وَخَسَفَ ٱلْقَمَرُ"},{"key":"75:9","text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"},{"key":"75:10","text":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"},{"key":"75:11","text":"كَلَّا لَا وَزَرَ"},{"key":"75:12","text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"},{"key":"75:13","text":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"},{"key":"75:14","text":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"},{"key":"75:15","text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"key":"75:16","text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"key":"75:17","text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"},{"key":"75:18","text":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"},{"key":"75:19","text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"}]