[{"key":"53:1","text":" وَٱلنَّجْمِ إِذَا هَوَىٰ"},{"key":"53:2","text":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"},{"key":"53:3","text":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ"},{"key":"53:4","text":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ"},{"key":"53:5","text":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ"},{"key":"53:6","text":"ذُو مِرَّةٍ فَٱسْتَوَىٰ"},{"key":"53:7","text":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ"},{"key":"53:8","text":"ثُمَّ دَنَا فَتَدَلَّىٰ"},{"key":"53:9","text":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ"},{"key":"53:10","text":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ"},{"key":"53:11","text":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ"},{"key":"53:12","text":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ"},{"key":"53:13","text":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ"},{"key":"53:14","text":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ"},{"key":"53:15","text":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ"},{"key":"53:16","text":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ"},{"key":"53:17","text":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ"},{"key":"53:18","text":"لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ"},{"key":"53:19","text":"أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ"},{"key":"53:20","text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ"},{"key":"53:21","text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ"},{"key":"53:22","text":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ"},{"key":"53:23","text":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ"},{"key":"53:24","text":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ"},{"key":"53:25","text":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ"},{"key":"53:26","text":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ"}]