[{"key":"77:20","text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"},{"key":"77:21","text":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ"},{"key":"77:22","text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"key":"77:23","text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"},{"key":"77:24","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:25","text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"key":"77:26","text":"أَحْيَآءً وَأَمْوَٰتًا"},{"key":"77:27","text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا"},{"key":"77:28","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:29","text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"key":"77:30","text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ"},{"key":"77:31","text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"},{"key":"77:32","text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"},{"key":"77:33","text":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ"},{"key":"77:34","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:35","text":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ"},{"key":"77:36","text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"key":"77:37","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:38","text":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"},{"key":"77:39","text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"key":"77:40","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:41","text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ"},{"key":"77:42","text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"},{"key":"77:43","text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"},{"key":"77:44","text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"key":"77:45","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:46","text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"key":"77:47","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:48","text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"},{"key":"77:49","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"key":"77:50","text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]