[{"key":"53:45","text":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ"},{"key":"53:46","text":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ"},{"key":"53:47","text":"وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ"},{"key":"53:48","text":"وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ"},{"key":"53:49","text":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ"},{"key":"53:50","text":"وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ"},{"key":"53:51","text":"وَثَمُودَا۟ فَمَآ أَبْقَىٰ"},{"key":"53:52","text":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ"},{"key":"53:53","text":"وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ"},{"key":"53:54","text":"فَغَشَّىٰهَا مَا غَشَّىٰ"},{"key":"53:55","text":"فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ"},{"key":"53:56","text":"هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ"},{"key":"53:57","text":"أَزِفَتِ ٱلْـَٔازِفَةُ"},{"key":"53:58","text":"لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ"},{"key":"53:59","text":"أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ"},{"key":"53:60","text":"وَتَضْحَكُونَ وَلَا تَبْكُونَ"},{"key":"53:61","text":"وَأَنتُمْ سَـٰمِدُونَ"},{"key":"53:62","text":"فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩"},{"key":"54:1","text":" ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ"},{"key":"54:2","text":"وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ"},{"key":"54:3","text":"وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ"},{"key":"54:4","text":"وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ"},{"key":"54:5","text":"حِكْمَةٌۢ بَـٰلِغَةٌ ۖ فَمَا تُغْنِ ٱلنُّذُرُ"},{"key":"54:6","text":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ"}]