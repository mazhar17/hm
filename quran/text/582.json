[{"key":"78:1","text":" عَمَّ يَتَسَآءَلُونَ"},{"key":"78:2","text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"},{"key":"78:3","text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"},{"key":"78:4","text":"كَلَّا سَيَعْلَمُونَ"},{"key":"78:5","text":"ثُمَّ كَلَّا سَيَعْلَمُونَ"},{"key":"78:6","text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا"},{"key":"78:7","text":"وَٱلْجِبَالَ أَوْتَادًا"},{"key":"78:8","text":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا"},{"key":"78:9","text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"},{"key":"78:10","text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا"},{"key":"78:11","text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا"},{"key":"78:12","text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"},{"key":"78:13","text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا"},{"key":"78:14","text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا"},{"key":"78:15","text":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا"},{"key":"78:16","text":"وَجَنَّـٰتٍ أَلْفَافًا"},{"key":"78:17","text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا"},{"key":"78:18","text":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا"},{"key":"78:19","text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا"},{"key":"78:20","text":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"},{"key":"78:21","text":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"},{"key":"78:22","text":"لِّلطَّـٰغِينَ مَـَٔابًا"},{"key":"78:23","text":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا"},{"key":"78:24","text":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"},{"key":"78:25","text":"إِلَّا حَمِيمًا وَغَسَّاقًا"},{"key":"78:26","text":"جَزَآءً وِفَاقًا"},{"key":"78:27","text":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا"},{"key":"78:28","text":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا"},{"key":"78:29","text":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا"},{"key":"78:30","text":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"}]