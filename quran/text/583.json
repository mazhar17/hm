[{"key":"78:31","text":"إِنَّ لِلْمُتَّقِينَ مَفَازًا"},{"key":"78:32","text":"حَدَآئِقَ وَأَعْنَـٰبًا"},{"key":"78:33","text":"وَكَوَاعِبَ أَتْرَابًا"},{"key":"78:34","text":"وَكَأْسًا دِهَاقًا"},{"key":"78:35","text":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا"},{"key":"78:36","text":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا"},{"key":"78:37","text":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"},{"key":"78:38","text":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا"},{"key":"78:39","text":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"},{"key":"78:40","text":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا"},{"key":"79:1","text":" وَٱلنَّـٰزِعَـٰتِ غَرْقًا"},{"key":"79:2","text":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا"},{"key":"79:3","text":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا"},{"key":"79:4","text":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا"},{"key":"79:5","text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا"},{"key":"79:6","text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"},{"key":"79:7","text":"تَتْبَعُهَا ٱلرَّادِفَةُ"},{"key":"79:8","text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"},{"key":"79:9","text":"أَبْصَـٰرُهَا خَـٰشِعَةٌ"},{"key":"79:10","text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"},{"key":"79:11","text":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً"},{"key":"79:12","text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"},{"key":"79:13","text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"},{"key":"79:14","text":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"key":"79:15","text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"}]