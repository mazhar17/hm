[{"key":"54:50","text":"وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةٌ كَلَمْحٍۭ بِٱلْبَصَرِ"},{"key":"54:51","text":"وَلَقَدْ أَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرٍ"},{"key":"54:52","text":"وَكُلُّ شَىْءٍ فَعَلُوهُ فِى ٱلزُّبُرِ"},{"key":"54:53","text":"وَكُلُّ صَغِيرٍ وَكَبِيرٍ مُّسْتَطَرٌ"},{"key":"54:54","text":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَهَرٍ"},{"key":"54:55","text":"فِى مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍۭ"},{"key":"55:1","text":" ٱلرَّحْمَـٰنُ"},{"key":"55:2","text":"عَلَّمَ ٱلْقُرْءَانَ"},{"key":"55:3","text":"خَلَقَ ٱلْإِنسَـٰنَ"},{"key":"55:4","text":"عَلَّمَهُ ٱلْبَيَانَ"},{"key":"55:5","text":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"},{"key":"55:6","text":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"},{"key":"55:7","text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"},{"key":"55:8","text":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"},{"key":"55:9","text":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"},{"key":"55:10","text":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"key":"55:11","text":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"},{"key":"55:12","text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"},{"key":"55:13","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"},{"key":"55:14","text":"خَلَقَ ٱلْإِنسَـٰنَ مِن صَلْصَـٰلٍ كَٱلْفَخَّارِ"},{"key":"55:15","text":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"},{"key":"55:16","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"}]