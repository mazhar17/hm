[{"key":"112:1","text":" قُلْ هُوَ ٱللَّهُ أَحَدٌ"},{"key":"112:2","text":"ٱللَّهُ ٱلصَّمَدُ"},{"key":"112:3","text":"لَمْ يَلِدْ وَلَمْ يُولَدْ"},{"key":"112:4","text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"},{"key":"113:1","text":" قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"key":"113:2","text":"مِن شَرِّ مَا خَلَقَ"},{"key":"113:3","text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"key":"113:4","text":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},{"key":"113:5","text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"},{"key":"114:1","text":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"key":"114:2","text":"مَلِكِ ٱلنَّاسِ"},{"key":"114:3","text":"إِلَـٰهِ ٱلنَّاسِ"},{"key":"114:4","text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"key":"114:5","text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"key":"114:6","text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]