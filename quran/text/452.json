[{"key":"37:154","text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ"},{"key":"37:155","text":"أَفَلَا تَذَكَّرُونَ"},{"key":"37:156","text":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ"},{"key":"37:157","text":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ"},{"key":"37:158","text":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"},{"key":"37:159","text":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"},{"key":"37:160","text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"key":"37:161","text":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ"},{"key":"37:162","text":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ"},{"key":"37:163","text":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"},{"key":"37:164","text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"},{"key":"37:165","text":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"},{"key":"37:166","text":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"},{"key":"37:167","text":"وَإِن كَانُوا۟ لَيَقُولُونَ"},{"key":"37:168","text":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"},{"key":"37:169","text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"},{"key":"37:170","text":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ"},{"key":"37:171","text":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"},{"key":"37:172","text":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"},{"key":"37:173","text":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ"},{"key":"37:174","text":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"key":"37:175","text":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"},{"key":"37:176","text":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"},{"key":"37:177","text":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"},{"key":"37:178","text":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"},{"key":"37:179","text":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"},{"key":"37:180","text":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"},{"key":"37:181","text":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ"},{"key":"37:182","text":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"}]