[{"key":"75:20","text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"},{"key":"75:21","text":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ"},{"key":"75:22","text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"},{"key":"75:23","text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"key":"75:24","text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"},{"key":"75:25","text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"},{"key":"75:26","text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"},{"key":"75:27","text":"وَقِيلَ مَنْ ۜ رَاقٍ"},{"key":"75:28","text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"},{"key":"75:29","text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"},{"key":"75:30","text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"},{"key":"75:31","text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"key":"75:32","text":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ"},{"key":"75:33","text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"},{"key":"75:34","text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"key":"75:35","text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"key":"75:36","text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى"},{"key":"75:37","text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"},{"key":"75:38","text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"},{"key":"75:39","text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"},{"key":"75:40","text":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"},{"key":"76:1","text":" هَلْ أَتَىٰ عَلَى ٱلْإِنسَـٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا"},{"key":"76:2","text":"إِنَّا خَلَقْنَا ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَـٰهُ سَمِيعًۢا بَصِيرًا"},{"key":"76:3","text":"إِنَّا هَدَيْنَـٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا"},{"key":"76:4","text":"إِنَّآ أَعْتَدْنَا لِلْكَـٰفِرِينَ سَلَـٰسِلَا۟ وَأَغْلَـٰلًا وَسَعِيرًا"},{"key":"76:5","text":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا"}]