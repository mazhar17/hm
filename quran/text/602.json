[{"key":"106:1","text":" لِإِيلَـٰفِ قُرَيْشٍ"},{"key":"106:2","text":"إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"},{"key":"106:3","text":"فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ"},{"key":"106:4","text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"},{"key":"107:1","text":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"key":"107:2","text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"key":"107:3","text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"key":"107:4","text":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"key":"107:5","text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"key":"107:6","text":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"key":"107:7","text":"وَيَمْنَعُونَ ٱلْمَاعُونَ"},{"key":"108:1","text":" إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ"},{"key":"108:2","text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ"},{"key":"108:3","text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"}]