[{"key":"69:35","text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ"},{"key":"69:36","text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ"},{"key":"69:37","text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ"},{"key":"69:38","text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ"},{"key":"69:39","text":"وَمَا لَا تُبْصِرُونَ"},{"key":"69:40","text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"key":"69:41","text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ"},{"key":"69:42","text":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ"},{"key":"69:43","text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"key":"69:44","text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ"},{"key":"69:45","text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ"},{"key":"69:46","text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ"},{"key":"69:47","text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ"},{"key":"69:48","text":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ"},{"key":"69:49","text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ"},{"key":"69:50","text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ"},{"key":"69:51","text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ"},{"key":"69:52","text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"key":"70:1","text":" سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ"},{"key":"70:2","text":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ"},{"key":"70:3","text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ"},{"key":"70:4","text":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ"},{"key":"70:5","text":"فَٱصْبِرْ صَبْرًا جَمِيلًا"},{"key":"70:6","text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا"},{"key":"70:7","text":"وَنَرَىٰهُ قَرِيبًا"},{"key":"70:8","text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ"},{"key":"70:9","text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ"},{"key":"70:10","text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا"}]