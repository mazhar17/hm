[{"key":"70:11","text":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ"},{"key":"70:12","text":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ"},{"key":"70:13","text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ"},{"key":"70:14","text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ"},{"key":"70:15","text":"كَلَّآ ۖ إِنَّهَا لَظَىٰ"},{"key":"70:16","text":"نَزَّاعَةً لِّلشَّوَىٰ"},{"key":"70:17","text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"key":"70:18","text":"وَجَمَعَ فَأَوْعَىٰٓ"},{"key":"70:19","text":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا"},{"key":"70:20","text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا"},{"key":"70:21","text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا"},{"key":"70:22","text":"إِلَّا ٱلْمُصَلِّينَ"},{"key":"70:23","text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ"},{"key":"70:24","text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ"},{"key":"70:25","text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ"},{"key":"70:26","text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ"},{"key":"70:27","text":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"key":"70:28","text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ"},{"key":"70:29","text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ"},{"key":"70:30","text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ"},{"key":"70:31","text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ"},{"key":"70:32","text":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ"},{"key":"70:33","text":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ"},{"key":"70:34","text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"key":"70:35","text":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ"},{"key":"70:36","text":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ"},{"key":"70:37","text":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ"},{"key":"70:38","text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ"},{"key":"70:39","text":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ"}]